# systemd --user unit for THIS MediaTracker daemon (the online-journal tracker).
#
# NOTE: the AlgoTrade project has its OWN, unrelated daemon also called
# "mediatracker" (it tracks X/YouTube/RSS/Gmail). To avoid any collision this
# unit is deliberately named "mediatracker-journals" and listens on port 55030.
# Never manage the AlgoTrade daemon from here, and never identify this one by the
# bare "python3 -m mediatracker" cmdline (both share it) — use the port or the
# unit name.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   ln -s "$PWD/mediatracker-journals.service" ~/.config/systemd/user/mediatracker-journals.service
#   loginctl enable-linger "$USER"           # keep running after logout
#   systemctl --user daemon-reload
#   systemctl --user enable --now mediatracker-journals
# Logs:  journalctl --user -u mediatracker-journals -f
#
# Adjust WorkingDirectory/ExecStart paths if the repo lives elsewhere.

[Unit]
Description=MediaTracker (journals) — online-journal article & comment tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/mediatracker/mediatracker
ExecStart=/usr/bin/python3 -m mediatracker --host 127.0.0.1 --port 55030 --log-level INFO
Restart=on-failure
RestartSec=10
# Postgres credentials live outside the repo; point at the secret file if not
# using the default search path (see db.py).
# Environment=POSTGRE_USER=... POSTGRE_PASSWORD=...

[Install]
WantedBy=default.target
