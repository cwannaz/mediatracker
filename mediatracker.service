# systemd --user unit for the MediaTracker daemon.
# Install:
#   mkdir -p ~/.config/systemd/user
#   ln -s "$PWD/mediatracker.service" ~/.config/systemd/user/mediatracker.service
#   loginctl enable-linger "$USER"           # keep running after logout
#   systemctl --user daemon-reload
#   systemctl --user enable --now mediatracker
# Logs:  journalctl --user -u mediatracker -f
#
# Adjust WorkingDirectory/ExecStart paths if the repo lives elsewhere.

[Unit]
Description=MediaTracker — online-journal article & comment tracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/mediatracker/mediatracker
ExecStart=/usr/bin/python3 -m mediatracker --host 127.0.0.1 --port 55030 --log-level INFO
Restart=on-failure
RestartSec=10
# Postgres credentials live outside the repo; point at the secret file if not
# using the default search path (see db.py).
# Environment=POSTGRE_USER=... POSTGRE_PASSWORD=...

[Install]
WantedBy=default.target
